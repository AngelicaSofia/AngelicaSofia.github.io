---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% assign year = null %}

    {% for item in collection reversed %}
      {% assign item_year = item.date | date: '%Y' | plus: 0 %}
      {% if item_year < 2025 %}
        {% assign current_year = 'Key Past Reads' %}
      {% else %}
        {% assign current_year = item_year %}
      {% endif %}

      {% if current_year != year %}
        {% unless forloop.first %}
          </ul>
        {% endunless %}

        <h1 id="y{{ current_year | replace: ' ', '-' }}">
          {% if current_year != 'Key Past Reads' %}
            <a href="{{ current_year | prepend: '/books/' | relative_url }}">
              {{ current_year }}
            </a>
          {% else %}
            {{ current_year }}
          {% endif %}
        </h1>

        <ul class="bookshelf">
          {% assign year = current_year %}
      {% endif %}

      <figure class="cover">
        <a class="cover-link" href="{{ item.url | relative_url }}">
          {% if item.cover %}
            <img
              alt="{{ item.title }} cover"
              src="{{ item.cover | prepend: page.covers | relative_url }}"
              style="height:200px"
            >
          {% elsif item.olid %}
            <img
              alt="{{ item.title }} cover"
              src="http://covers.openlibrary.org/b/olid/{{ item.olid }}-L.jpg?default=false"
              style="height:200px"
            >
          {% elsif item.isbn %}
            <img
              alt="{{ item.title }} cover"
              src="http://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false"
              style="height:200px"
            >
          {% endif %}

          {% if item.status %}
            {% assign statuses = 'abandoned,finished,interested,paused,queued,reading,reread' | split: ',' %}
            {% assign status = item.status | downcase | strip %}

            {% if statuses contains status %}
              <figcaption class="{{ status }}">
                {% if status == 'finished' and item.language %}
                  <span class="language-flag">
                    {% case item.language %}
                      {% when 'Italian' %}
                        🇮🇹
                      {% when 'English' %}
                        🇬🇧
                      {% when 'Spanish' %}
                        🇪🇸
                      {% when 'French' %}
                        🇫🇷
                      {% when 'German' %}
                        🇩🇪
                    {% endcase %}
                  </span>
                {% endif %}
              </figcaption>
            {% else %}
              <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
            {% endif %}
          {% else %}
            <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
          {% endif %}
        </a>
      </figure>

      {% if forloop.last %}
        </ul>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
